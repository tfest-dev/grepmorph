cmake_minimum_required(VERSION 3.20)
if(NOT DEFINED PROGRAM OR NOT DEFINED CASE OR NOT DEFINED WORK_DIR OR NOT DEFINED SOURCE_DIR)
    message(FATAL_ERROR "Missing test arguments")
endif()
file(REMOVE_RECURSE "${WORK_DIR}")
file(MAKE_DIRECTORY "${WORK_DIR}")
file(COPY "${SOURCE_DIR}/fixtures/" DESTINATION "${WORK_DIR}")
set(error "")
if(CASE STREQUAL "hex_literal")
    set(args "--morph" "hex-text" "kL" "value-hex.txt")
    set(expected "value-hex.txt:0x0000000000000000:hex-text\nvalue-hex.txt:0x0000000000000005:hex-text\nvalue-hex.txt:0x000000000000000a:hex-text\n")
    set(code 0)
elseif(CASE STREQUAL "hex_binary")
    set(args "--hex" "--morph" "hex-text" "00 ff 00" "value-hex-binary.bin")
    set(expected "value-hex-binary.bin:0x0000000000000000:hex-text\nvalue-hex-binary.bin:0x0000000000000007:hex-text\nvalue-hex-binary.bin:0x000000000000000e:hex-text\n")
    set(code 0)
elseif(CASE STREQUAL "hex_binary_reordered")
    set(args "--morph" "hex-text" "--hex" "00 ff 00" "value-hex-binary.bin")
    set(expected "value-hex-binary.bin:0x0000000000000000:hex-text\nvalue-hex-binary.bin:0x0000000000000007:hex-text\nvalue-hex-binary.bin:0x000000000000000e:hex-text\n")
    set(code 0)
elseif(CASE STREQUAL "hex_and_raw")
    set(args "--hex" "--morph" "hex-text" "--morph" "raw" "00 ff 00" "value-hex-binary.bin")
    set(expected "value-hex-binary.bin:0x0000000000000000:hex-text\nvalue-hex-binary.bin:0x0000000000000007:hex-text\nvalue-hex-binary.bin:0x000000000000000e:hex-text\nvalue-hex-binary.bin:0x000000000000001e:raw\n")
    set(code 0)
elseif(CASE STREQUAL "hex_is_not_input_decoding")
    set(args "--morph" "hex-text" "00ff00" "value-hex-binary.bin")
    set(expected "")
    set(code 1)
elseif(CASE STREQUAL "raw_stays_case_sensitive")
    set(args "6b4c" "value-hex.txt")
    set(expected "value-hex.txt:0x0000000000000000:raw\n")
    set(code 0)
elseif(CASE STREQUAL "hex_numeric_lexeme")
    set(args "--morph" "hex-text" "12000" "value-forms.bin")
    set(expected "value-forms.bin:0x0000000000000060:hex-text\n")
    set(code 0)
elseif(CASE STREQUAL "uint16_le")
    set(args "--morph" "uint16-le" "12000" "value-forms.bin")
    set(expected "value-forms.bin:0x0000000000000010:uint16-le\nvalue-forms.bin:0x0000000000000020:uint16-le\nvalue-forms.bin:0x0000000000000040:uint16-le\n")
    set(code 0)
elseif(CASE STREQUAL "uint16_be")
    set(args "--morph" "uint16-be" "12000" "value-forms.bin")
    set(expected "value-forms.bin:0x0000000000000018:uint16-be\nvalue-forms.bin:0x0000000000000032:uint16-be\nvalue-forms.bin:0x0000000000000056:uint16-be\n")
    set(code 0)
elseif(CASE STREQUAL "uint32_le")
    set(args "--morph" "uint32-le" "12000" "value-forms.bin")
    set(expected "value-forms.bin:0x0000000000000020:uint32-le\nvalue-forms.bin:0x0000000000000040:uint32-le\n")
    set(code 0)
elseif(CASE STREQUAL "uint32_be")
    set(args "--morph" "uint32-be" "12000" "value-forms.bin")
    set(expected "value-forms.bin:0x0000000000000030:uint32-be\nvalue-forms.bin:0x0000000000000054:uint32-be\n")
    set(code 0)
elseif(CASE STREQUAL "uint64_le")
    set(args "--morph" "uint64-le" "12000" "value-forms.bin")
    set(expected "value-forms.bin:0x0000000000000040:uint64-le\n")
    set(code 0)
elseif(CASE STREQUAL "uint64_be")
    set(args "--morph" "uint64-be" "12000" "value-forms.bin")
    set(expected "value-forms.bin:0x0000000000000050:uint64-be\n")
    set(code 0)
elseif(CASE STREQUAL "uint8")
    set(args "--morph" "uint8" "255" "binary.bin")
    set(expected "binary.bin:0x0000000000000001:uint8\nbinary.bin:0x0000000000000003:uint8\n")
    set(code 0)
elseif(CASE STREQUAL "integer_hex_lexeme")
    set(args "--morph" "uint16-le" "0x2EE0" "value-forms.bin")
    set(expected "value-forms.bin:0x0000000000000010:uint16-le\nvalue-forms.bin:0x0000000000000020:uint16-le\nvalue-forms.bin:0x0000000000000040:uint16-le\n")
    set(code 0)
elseif(CASE STREQUAL "integer_upper_prefix")
    set(args "--morph" "uint16-be" "0X2ee0" "value-forms.bin")
    set(expected "value-forms.bin:0x0000000000000018:uint16-be\nvalue-forms.bin:0x0000000000000032:uint16-be\nvalue-forms.bin:0x0000000000000056:uint16-be\n")
    set(code 0)
elseif(CASE STREQUAL "leading_zero_is_decimal")
    set(args "--morph" "uint8" "010" "value-leading-zero.bin")
    set(expected "value-leading-zero.bin:0x0000000000000000:uint8\n")
    set(code 0)
elseif(CASE STREQUAL "uint64_max")
    set(args "--morph" "uint64-le" "--morph" "uint64-be" "18446744073709551615" "value-max.bin")
    set(expected "value-max.bin:0x0000000000000000:uint64-le\nvalue-max.bin:0x0000000000000000:uint64-be\n")
    set(code 0)
elseif(CASE STREQUAL "uint64_max_hex")
    set(args "--morph" "uint64-be" "0xffffffffffffffff" "value-max.bin")
    set(expected "value-max.bin:0x0000000000000000:uint64-be\n")
    set(code 0)
elseif(CASE STREQUAL "all_fitting_integer_widths")
    set(args "--morph" "uint64-be" "--morph" "uint64-le" "--morph" "uint32-be" "--morph" "uint32-le" "--morph" "uint16-be" "--morph" "uint16-le" "12000" "value-forms.bin")
    set(expected "value-forms.bin:0x0000000000000010:uint16-le\nvalue-forms.bin:0x0000000000000018:uint16-be\nvalue-forms.bin:0x0000000000000020:uint16-le\nvalue-forms.bin:0x0000000000000020:uint32-le\nvalue-forms.bin:0x0000000000000030:uint32-be\nvalue-forms.bin:0x0000000000000032:uint16-be\nvalue-forms.bin:0x0000000000000040:uint16-le\nvalue-forms.bin:0x0000000000000040:uint32-le\nvalue-forms.bin:0x0000000000000040:uint64-le\nvalue-forms.bin:0x0000000000000050:uint64-be\nvalue-forms.bin:0x0000000000000054:uint32-be\nvalue-forms.bin:0x0000000000000056:uint16-be\n")
    set(code 0)
elseif(CASE STREQUAL "mixed_text_numeric")
    set(args "--morph" "uint16-le" "--morph" "hex-text" "--morph" "utf8" "--morph" "raw" "12000" "value-forms.bin")
    set(expected "value-forms.bin:0x0000000000000000:raw\nvalue-forms.bin:0x0000000000000000:utf8\nvalue-forms.bin:0x0000000000000010:uint16-le\nvalue-forms.bin:0x0000000000000020:uint16-le\nvalue-forms.bin:0x0000000000000040:uint16-le\nvalue-forms.bin:0x0000000000000060:hex-text\n")
    set(code 0)
elseif(CASE STREQUAL "numeric_boundary")
    set(args "--morph" "uint64-le" "12000" "value-boundary.bin")
    set(expected "value-boundary.bin:0x000000000000ffff:uint64-le\n")
    set(code 0)
elseif(CASE STREQUAL "no_match")
    set(args "--morph" "uint16-le" "12100" "value-forms.bin")
    set(expected "")
    set(code 1)
elseif(CASE STREQUAL "u8_overflow")
    set(args "--morph" "uint8" "256" "value-forms.bin")
    set(expected "")
    set(code 2)
    set(error "does not fit")
elseif(CASE STREQUAL "u16_overflow")
    set(args "--morph" "uint16-be" "65536" "value-forms.bin")
    set(expected "")
    set(code 2)
    set(error "does not fit")
elseif(CASE STREQUAL "u32_overflow")
    set(args "--morph" "uint32-le" "4294967296" "value-forms.bin")
    set(expected "")
    set(code 2)
    set(error "does not fit")
elseif(CASE STREQUAL "u64_overflow")
    set(args "--morph" "uint64-le" "18446744073709551616" "value-forms.bin")
    set(expected "")
    set(code 2)
    set(error "does not fit")
elseif(CASE STREQUAL "u64_hex_overflow")
    set(args "--morph" "uint64-be" "0x10000000000000000" "value-forms.bin")
    set(expected "")
    set(code 2)
    set(error "does not fit")
elseif(CASE STREQUAL "negative")
    set(args "--morph" "uint16-le" "--" "-1" "value-forms.bin")
    set(expected "")
    set(code 2)
    set(error "invalid unsigned integer")
elseif(CASE STREQUAL "positive_sign")
    set(args "--morph" "uint16-le" "--" "+1" "value-forms.bin")
    set(expected "")
    set(code 2)
    set(error "invalid unsigned integer")
elseif(CASE STREQUAL "space")
    set(args "--morph" "uint16-le" "--" " 1" "value-forms.bin")
    set(expected "")
    set(code 2)
    set(error "invalid unsigned integer")
elseif(CASE STREQUAL "float")
    set(args "--morph" "uint16-le" "--" "1.0" "value-forms.bin")
    set(expected "")
    set(code 2)
    set(error "invalid unsigned integer")
elseif(CASE STREQUAL "exponent")
    set(args "--morph" "uint16-le" "--" "1e3" "value-forms.bin")
    set(expected "")
    set(code 2)
    set(error "invalid unsigned integer")
elseif(CASE STREQUAL "separator")
    set(args "--morph" "uint16-le" "--" "1_000" "value-forms.bin")
    set(expected "")
    set(code 2)
    set(error "invalid unsigned integer")
elseif(CASE STREQUAL "no_prefix")
    set(args "--morph" "uint16-le" "--" "ff" "value-forms.bin")
    set(expected "")
    set(code 2)
    set(error "invalid unsigned integer")
elseif(CASE STREQUAL "empty_prefix")
    set(args "--morph" "uint16-le" "--" "0x" "value-forms.bin")
    set(expected "")
    set(code 2)
    set(error "invalid unsigned integer")
elseif(CASE STREQUAL "narrow_width_not_omitted")
    set(args "--morph" "raw" "--morph" "uint64-le" "--morph" "uint8" "256" "value-forms.bin")
    set(expected "")
    set(code 2)
    set(error "does not fit")
elseif(CASE STREQUAL "widthless_rejected")
    set(args "--morph" "uint-le" "12000" "value-forms.bin")
    set(expected "")
    set(code 2)
    set(error "unsupported or repeated morph")
elseif(CASE STREQUAL "signed_rejected")
    set(args "--morph" "int16-le" "1" "value-forms.bin")
    set(expected "")
    set(code 2)
    set(error "unsupported or repeated morph")
elseif(CASE STREQUAL "duplicate_morph")
    set(args "--morph" "uint16-le" "--morph" "uint16-le" "12000" "value-forms.bin")
    set(expected "")
    set(code 2)
    set(error "unsupported or repeated morph")
elseif(CASE STREQUAL "hex_integer_conflict")
    set(args "--hex" "--morph" "uint16-le" "e02e" "value-forms.bin")
    set(expected "")
    set(code 2)
    set(error "supports only raw and hex-text")
elseif(CASE STREQUAL "integer_hex_conflict")
    set(args "--morph" "uint16-le" "--hex" "e02e" "value-forms.bin")
    set(expected "")
    set(code 2)
    set(error "supports only raw and hex-text")
elseif(CASE STREQUAL "hex_unicode_conflict")
    set(args "--hex" "--morph" "utf8" "6162" "value-forms.bin")
    set(expected "")
    set(code 2)
    set(error "supports only raw and hex-text")
elseif(CASE STREQUAL "text_integer_conflict")
    set(args "--text" "--morph" "uint16-le" "12000" "value-forms.bin")
    set(expected "")
    set(code 2)
    set(error "conflicting option")
elseif(CASE STREQUAL "recursive")
    file(MAKE_DIRECTORY "${WORK_DIR}/tree/nested")
    file(COPY "${SOURCE_DIR}/fixtures/value-forms.bin" DESTINATION "${WORK_DIR}/tree/nested")
    set(args "-r" "--morph" "uint16-le" "12000" "tree")
    set(expected "tree/nested/value-forms.bin:0x0000000000000010:uint16-le\ntree/nested/value-forms.bin:0x0000000000000020:uint16-le\ntree/nested/value-forms.bin:0x0000000000000040:uint16-le\n")
    set(code 0)
elseif(CASE STREQUAL "error_precedence")
    set(args "--morph" "uint16-le" "12000" "missing.bin" "value-forms.bin")
    set(expected "value-forms.bin:0x0000000000000010:uint16-le\nvalue-forms.bin:0x0000000000000020:uint16-le\nvalue-forms.bin:0x0000000000000040:uint16-le\n")
    set(code 2)
    set(error "missing.bin")
elseif(CASE STREQUAL "hex_overlap")
    file(WRITE "${WORK_DIR}/overlap.bin" "aaaaaa")
    set(args "--hex" "--morph" "hex-text" "aa" "overlap.bin")
    set(expected "overlap.bin:0x0000000000000000:hex-text\noverlap.bin:0x0000000000000001:hex-text\noverlap.bin:0x0000000000000002:hex-text\noverlap.bin:0x0000000000000003:hex-text\noverlap.bin:0x0000000000000004:hex-text\n")
    set(code 0)
elseif(CASE STREQUAL "hex_separators_not_ignored")
    file(WRITE "${WORK_DIR}/separated.bin" "aa bb")
    set(args "--hex" "--morph" "hex-text" "aa bb" "separated.bin")
    set(expected "")
    set(code 1)
elseif(CASE STREQUAL "hex_boundary")
    string(REPEAT "|" 65535 prefix)
    file(WRITE "${WORK_DIR}/boundary.txt" "${prefix}6B4C")
    set(args "--morph" "hex-text" "kL" "boundary.txt")
    set(expected "boundary.txt:0x000000000000ffff:hex-text\n")
    set(code 0)
else()
    message(FATAL_ERROR "Unknown test case: ${CASE}")
endif()
execute_process(COMMAND "${PROGRAM}" ${args}
    WORKING_DIRECTORY "${WORK_DIR}" RESULT_VARIABLE actual
    OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 30)
string(REPLACE "\r\n" "\n" out "${out}")
if(NOT "${actual}" STREQUAL "${code}" OR NOT "${out}" STREQUAL "${expected}")
    message(FATAL_ERROR "${CASE}: code=${actual} expected=${code}\nout=${out}\nexpected=${expected}\nerr=${err}")
endif()
if(code EQUAL 2)
    if(err STREQUAL "" OR (NOT error STREQUAL "" AND NOT err MATCHES "${error}"))
        message(FATAL_ERROR "Missing diagnostic '${error}': ${err}")
    endif()
elseif(NOT err STREQUAL "")
    message(FATAL_ERROR "Unexpected diagnostic: ${err}")
endif()
